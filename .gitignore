# THIS REPO IS PUBLIC. Nothing private may land here.

# Secrets and machine-local state
.secrets
home/.config/git/config.local
home/.aws/credentials
home/.aws/config
*.local

# The repo manifest lists private repo and org names — it lives in
# ~/.config/repos.txt, never here. Ignored in case it is ever generated in place.
repos.txt

# Keys and certs, in case one is ever dropped in by accident
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.hst.local

# Scratch
tmp/

# OS / editor
.DS_Store
.idea/
.vscode/
