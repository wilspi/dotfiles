#!/usr/bin/env bash
# Keep ~/Documents/CodeStuff the same on every machine — via git, not file sync.
#
#   repos            same as `repos status`
#   repos status     per-repo: dirty files, unpushed commits, current branch
#   repos discover   rebuild the manifest from your github account (needs `gh`)
#   repos clone      clone anything in the manifest that is missing here
#   repos pull       fast-forward every clean repo
#   repos add        add the repo in the current directory to the manifest
#   repos missing    list local repos that are NOT in the manifest
#
# The manifest lives at ~/.config/repos.txt, deliberately OUTSIDE this repo:
# dotfiles is public, and a list of clone URLs would publish the names of every
# private repo and org you work in. `repos discover` regenerates it from GitHub,
# so on a fresh machine there is nothing to copy across by hand.

set -uo pipefail

CODE_DIR="${CODE_DIR:-$HOME/Documents/CodeStuff}"
MANIFEST="${REPOS_MANIFEST:-${XDG_CONFIG_HOME:-$HOME/.config}/repos.txt}"

if [ -t 1 ]; then
	C_RED=$'\033[0;31m'; C_YEL=$'\033[0;33m'; C_GRN=$'\033[0;32m'
	C_BLU=$'\033[0;34m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
	C_RED=; C_YEL=; C_GRN=; C_BLU=; C_DIM=; C_OFF=
fi

entries() {
	[ -f "$MANIFEST" ] || return 0
	sed -e 's/#.*//' -e 's/[[:space:]]*$//' "$MANIFEST" | grep -v '^$'
}

# dir_for <url> — repo name, minus any .git suffix
dir_for() { local n="${1##*/}"; printf '%s' "${n%.git}"; }

cmd_clone() {
	local url dir
	while read -r url; do
		dir="$CODE_DIR/$(dir_for "$url")"
		if [ -d "$dir/.git" ]; then
			printf '%s\n' "${C_DIM}  - $(basename "$dir")${C_OFF}"
		else
			printf '%s\n' "${C_BLU}==>${C_OFF} cloning $(basename "$dir")"
			git clone "$url" "$dir" || printf '%s\n' "${C_RED}ERR${C_OFF} $url" >&2
		fi
	done < <(entries)
}

cmd_status() {
	local dir name dirty ahead branch flags
	for dir in "$CODE_DIR"/*/; do
		[ -d "$dir/.git" ] || continue
		name="$(basename "$dir")"
		branch="$(git -C "$dir" branch --show-current 2>/dev/null)"
		dirty="$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
		ahead="$(git -C "$dir" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)"

		flags=""
		[ "$dirty" != 0 ] && flags="$flags ${C_YEL}${dirty} dirty${C_OFF}"
		[ "$ahead" != 0 ] && flags="$flags ${C_RED}${ahead} unpushed${C_OFF}"
		[ -z "$flags" ]   && flags=" ${C_GRN}clean${C_OFF}"

		printf '  %-28s %-18s%b\n' "$name" "$branch" "$flags"
	done
}

cmd_pull() {
	local dir name
	for dir in "$CODE_DIR"/*/; do
		[ -d "$dir/.git" ] || continue
		name="$(basename "$dir")"
		if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
			printf '%s\n' "${C_YEL}  ! $name — dirty, skipped${C_OFF}"
			continue
		fi
		printf '%s\n' "${C_BLU}==>${C_OFF} $name"
		git -C "$dir" pull --ff-only 2>&1 | sed 's/^/    /'
	done
}

cmd_add() {
	local url
	url="$(git remote get-url origin 2>/dev/null)" || {
		echo "not in a git repo with an 'origin' remote" >&2; exit 1; }
	mkdir -p "$(dirname "$MANIFEST")"
	if entries | grep -qxF "$url"; then
		echo "already in the manifest: $url"
	else
		printf '%s\n' "$url" >> "$MANIFEST"
		echo "added to $MANIFEST: $url"
	fi
}

# Rebuild the manifest from GitHub. Owners default to your account plus every
# org you belong to, so private repos are included without ever being written
# into a public file.
cmd_discover() {
	command -v gh >/dev/null 2>&1 || { echo "needs the github cli: brew install gh" >&2; exit 1; }
	gh auth status >/dev/null 2>&1 || { echo "run: gh auth login" >&2; exit 1; }

	local owners
	if [ $# -gt 0 ]; then
		owners="$*"
	else
		owners="$(gh api user --jq .login) $(gh api user/orgs --jq '.[].login' 2>/dev/null)"
	fi

	mkdir -p "$(dirname "$MANIFEST")"
	{
		echo "# Generated by \`repos discover\` on $(date +%Y-%m-%d)."
		echo "# Owners: $owners"
		echo "# Private — never commit this to the public dotfiles repo."
		local owner
		for owner in $owners; do
			printf '%s\n' "${C_BLU}==>${C_OFF} $owner" >&2
			gh repo list "$owner" --limit 500 --no-archived --json sshUrl --jq '.[].sshUrl'
		done
	} > "$MANIFEST.tmp" && mv "$MANIFEST.tmp" "$MANIFEST"

	chmod 600 "$MANIFEST"
	printf '%s\n' "${C_GRN} ok${C_OFF} $(entries | wc -l | tr -d ' ') repos written to $MANIFEST"
}

cmd_missing() {
	local dir url
	for dir in "$CODE_DIR"/*/; do
		[ -d "$dir/.git" ] || continue
		url="$(git -C "$dir" remote get-url origin 2>/dev/null)" || continue
		entries | grep -qxF "$url" || printf '  %-28s %s\n' "$(basename "$dir")" "$url"
	done
}

case "${1:-status}" in
	clone)    cmd_clone ;;
	status)   cmd_status ;;
	pull)     cmd_pull ;;
	add)      cmd_add ;;
	missing)  cmd_missing ;;
	discover) shift; cmd_discover "$@" ;;
	-h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
	*) echo "unknown command: $1 (try --help)" >&2; exit 1 ;;
esac
