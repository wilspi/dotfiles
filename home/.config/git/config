# Tracked git config. Identity is NOT here — it lives in ~/.config/git/config.local,
# which the setup writes and .gitignore keeps out of the repo.

[include]
	path = config.local

[init]
	defaultBranch = main

[core]
	excludesfile = ~/.config/git/ignore
	editor = nvim
	autocrlf = input
	pager = less -FRX

[pull]
	rebase = false
	ff = only

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true
	prunetags = true

[merge]
	conflictstyle = zdiff3

[rebase]
	autosquash = true
	autostash = true

[diff]
	algorithm = histogram
	colorMoved = default

[branch]
	sort = -committerdate

[rerere]
	enabled = true

[commit]
	verbose = true

[help]
	autocorrect = prompt

[color]
	ui = auto

[alias]
	s = status -sb
	co = checkout
	sw = switch
	br = branch
	ci = commit
	amend = commit --amend --no-edit
	last = log -1 HEAD --stat
	unstage = restore --staged
	uncommit = reset --soft HEAD~1

[url "git@github.com:"]
	insteadOf = https://github.com/
