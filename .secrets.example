#!/usr/bin/env bash
# Copy to ~/.secrets (chmod 600) and fill in. Sourced by ~/.zshrc.
# Nothing in here belongs in a public repo.
#
# Git identity is NOT here — it lives in ~/.config/git/config.local,
# written by `./bootstrap.sh --only git`.

# --- api tokens ---
# export ANTHROPIC_API_KEY=""
# export OPENAI_API_KEY=""
# export GITHUB_TOKEN=""

# --- aws (prefer `aws sso login`; static keys only when you have no choice) ---
# export AWS_PROFILE="default"
# export AWS_ACCESS_KEY_ID=""
# export AWS_SECRET_ACCESS_KEY=""

# --- fly.io ---
# export FLY_API_TOKEN=""

# --- ollama on the arch box, reached over tailscale ---
# export OLLAMA_HOST="http://workstation:11434"

# --- machine-local overrides ---
# export EDITOR="nvim"
